#include<iostream>
using namespace std;

int fib(int n) {
    if (n==0||n==1)
    {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

int main() {
   
    cout << fib(0) << endl;
    cout << fib(1) << endl;
    cout << fib(5) << endl;
    cout << fib(6) << endl;
    cout << fib(10) << endl;
    int n;
    cout << "Enter number:";
    cin >> n;
    cout << fib(n) << endl;
  
    return 0;
}

